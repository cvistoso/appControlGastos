# Copy to .env and fill values. Do not commit .env.
# For local dev, you can also use appsettings.Development.json or User Secrets.

# PostgreSQL
ConnectionStrings__DefaultConnection=Host=localhost;Database=ExpenseControlDB;Username=postgres;Password=YOUR_PASSWORD

# JWT - Use a long random string in production (e.g. 64+ chars)
Jwt__SecretKey=YOUR_SECRET_KEY_AT_LEAST_32_CHARACTERS
Jwt__Issuer=ExpenseControl
Jwt__Audience=ExpenseControl
Jwt__AccessTokenExpiryMinutes=15

# Optional: first admin bootstrap (run once to create initial admin)
# BootstrapAdmin__Email=admin@example.com
# BootstrapAdmin__Password=SecurePassword123!
# BootstrapAdmin__FirstName=Admin
# BootstrapAdmin__LastName=User
